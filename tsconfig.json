{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "cli",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "cli/**/*.ts"
  ]
}
